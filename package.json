{
  "name": "@swapper-finance/orderly-universal-deposits",
  "version": "0.2.0",
  "description": "Orderly SDK plugin that makes Swapper the default deposit flow: fund an Orderly account from any chain, any token, a CEX or a card",
  "license": "MIT",
  "author": "Swapper Finance",
  "homepage": "https://swapper.finance",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swapperfinance/orderly-universal-deposits.git"
  },
  "bugs": {
    "url": "https://github.com/swapperfinance/orderly-universal-deposits/issues"
  },
  "keywords": [
    "orderly",
    "orderly-universal-deposits",
    "swapper",
    "deposit",
    "cross-chain",
    "onramp",
    "dex"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/styles.css": "./dist/styles.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "configSchema.json",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:css && tsup && cp .build/styles.css dist/styles.css",
    "build:css": "tailwindcss build -i src/tailwind.css -o .build/styles.css --minify",
    "dev": "pnpm run build:css && tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@orderly.network/hooks": ">=3.0.0",
    "@orderly.network/i18n": ">=3.0.0",
    "@orderly.network/plugin-core": ">=3.0.0",
    "@orderly.network/types": ">=3.0.0",
    "@orderly.network/ui": ">=3.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@orderly.network/hooks": "3.2.2",
    "@orderly.network/i18n": "3.2.2",
    "@orderly.network/plugin-core": "3.2.2",
    "@orderly.network/types": "3.2.2",
    "@orderly.network/ui": "3.2.2",
    "@swapper-finance/deposit-sdk": "^0.5.10",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.6",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
